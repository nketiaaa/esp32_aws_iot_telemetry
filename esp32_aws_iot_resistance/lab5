const int adcPin = 34; // ESP32 ADC pin
const float R1 = 10000.0; // Known resistor value in Ohms (10k ohms)

WiFiClientSecure net;
PubSubClient client(net);

void connectAWS() {
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  net.setCACert(CACERT);
  net.setCertificate(CERTIFICATE);
  net.setPrivateKey(PRIVATE_KEY);

  client.setServer(AWS_IOT_ENDPOINT, 8883);
  while (!client.connect("ESP32ResistanceClient")) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected to AWS IoT!");
}

void setup() {
  Serial.begin(115200);
  pinMode(adcPin, INPUT);
  connectAWS();
}

void loop() {
  if (!client.connected()) {
    connectAWS();
  }
  client.loop();

  int rawValue = analogRead(adcPin);
  float vOut = (rawValue / 4095.0) * 3.3;
  
  float r2 = 0;
  if (3.3 - vOut > 0.01) {
    r2 = R1 * (vOut / (3.3 - vOut));
  }

  String payload = "{\"timestamp\": \"" + String(millis()) + "\", \"v_out\": " + String(vOut) + ", \"calculated_resistance_ohms\": " + String(r2) + "}";
  client.publish("device/esp32/resistance", payload.c_str());
  
  delay(5000);
}

